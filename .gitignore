# Local secrets and application state
/BDCI/apis.txt
/BDCI/runtime/
**/.env
**/.env.local
**/.env.*.local
# Reproducible dependencies/build outputs
**/.venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.cache/
**/logs/
**/*.log
**/*.lock
/BDCI/tools/bin/
/BDCI/tools/tectonic-cache/
/BDCI/tools/*.zip
# Archived evidence already committed remains tracked; new runs are local by default.
/BDCI/research/runs/
/BDCI/validation/runs/
/BDCI/research/topic-v1-requests.jsonl
/BDCI/validation/live_requests.jsonl
**/*:Zone.Identifier
/BDCI/research/pilot_runs/
/BDCI/research/pilot-v1-requests.jsonl
/BDCI/research/prior_work/raw/
# The local development environment may be a symlink rather than a directory.
/BDCI/.venv
/BDCI/tools/bin
/BDCI/tools/tectonic-cache
/BDCI/research/paper_runs/
/BDCI/research/paper-v1-requests.jsonl
/BDCI/research/revision_runs/
/BDCI/research/research-v2-requests.jsonl
/BDCI/research/protocol_runs/
/BDCI/research/replay_runs/
/BDCI/research/replay_paper_runs/
